# --- Database (Postgres via Supabase or Neon) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Clerk webhook signing secret (Dashboard -> Webhooks -> your endpoint)
# Used to keep the local `User` table in sync with Clerk.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# --- AWS S3 (server-side only, never exposed to the client) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
S3_BUCKET_NAME="vehicle-damage-reports"
# Optional: only set this to point the S3 client at a local S3-compatible
# server (s3rver, MinIO, LocalStack) for local dev/testing. Leave unset in
# production so the SDK talks to real AWS.
# AWS_S3_ENDPOINT="http://127.0.0.1:4569"

# --- Anthropic (Claude, vision-enabled) ---
ANTHROPIC_API_KEY="sk-ant-..."
